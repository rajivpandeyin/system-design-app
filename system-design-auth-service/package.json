{
  "name": "system-design-auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch \"src/**/*.ts\" --exec \"node --loader ts-node/esm ./src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "ts-node src/migrate.ts",
    "seed": "ts-node src/seed.ts",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "@aws-sdk/client-s3": "^3.534.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.1",
    "pg": "^8.11.0",
    "sequelize": "^6.33.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.5.1",
    "@types/supertest": "^2.0.13",
    "@types/uuid": "^9.0.1",
    "jest": "^29.6.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
