{
  "name": "flairx-infrastructure",
  "version": "1.0.0",
  "description": "Production-grade AWS infrastructure for flairX using CDK",
  "main": "lib/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --all --require-approval=any-change",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:destroy": "cdk destroy --all --force",
    "cdk:nag": "cdk synth -c cdk-nag:asm-version=latest && npx cdk-nag"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.141.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.141.0",
    "cdk-nag": "^2.28.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
