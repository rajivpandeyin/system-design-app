        <!-- Notes -->
        <mxCell id="notes" value="Notes:&#10;• EC2 instances use IMDSv2 for secure credential fetching&#10;• All traffic encrypted (in-transit &amp; at-rest with KMS)&#10;• VPC endpoints provide free egress for S3&#10;• RDS in isolated subnet (no internet route)&#10;• Secrets cached in application (not API call per request)" style="text;html=1;strokeColor=#cccccc;fillColor=#f9f9f9;align=left;verticalAlign=top;fontSize=9;rounded=1;strokeWidth=1" vertex="1" parent="1">
